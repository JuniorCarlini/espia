{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "espia",
  "version": "0.1.0",
  "identifier": "com.espia.agent",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run prep",
    "beforeBuildCommand": "npm run prep"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "espia",
        "width": 1140,
        "height": 940,
        "minWidth": 860,
        "minHeight": 600,
        "backgroundColor": "#0a0a0c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      }
    }
  }
}
